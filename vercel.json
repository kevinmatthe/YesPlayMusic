{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/music.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/music-api/v1/:path*", "destination": "/api/music?__music_route=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/music-library-mvp": false
    }
  }
}
