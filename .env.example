# Same-origin personal API is /music-api/v1. No NetEase login or client cookie.
# Feishu availability and public AppID are discovered from /auth/options.
# App secrets and source credentials belong only in the backend environment.
# Optional local development proxy target (not a production browser URL):
MUSIC_DEV_API=http://127.0.0.1:37831

# Standalone runtime secrets. Supply the appropriate environment in Vercel.
# Development only, with a new, isolated local database:
# MUSIC_DATABASE_URL=postgresql://music_user:example@127.0.0.1:5432/yesplay_local
# Vercel Preview only, use a dedicated empty test database/branch:
# MUSIC_PREVIEW_DATABASE_URL=postgresql://music_user:example@preview-db.example/yesplay_preview?sslmode=verify-full
# Vercel Production only, once approved separately:
# MUSIC_DATABASE_URL=postgresql://music_user:example@prod-db.example/yesplay_prod?sslmode=verify-full

# Migration CLI only, never set in the Vercel runtime:
# MUSIC_DATABASE_SCOPE=local
# MUSIC_MIGRATION_DATABASE_URL=postgresql://schema_owner:example@127.0.0.1:5432/yesplay_local

# Optional server-only providers. The default is anonymous NetEase plus verified Kuwo.
# MUSIC_UNM_KUWO=0
# MUSIC_LASTFM_API_KEY=
# MUSIC_NETEASE_COOKIE=
